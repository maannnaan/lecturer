# Copy to .env.local and fill in. Never commit real values.

# Database. Leave empty for local development: an embedded Postgres is created in .data/pglite.
# Production: the Neon pooled connection string (postgres://…).
DATABASE_URL=

# Image uploads (Cloudinary dashboard → API Keys). Uploads stay off until all three are set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Used by `npm run seed:admin` to create the first platform admin.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
