# Copy to .env.local and fill in. Never commit real values.

# Database. Leave empty for local development: an embedded Postgres is created in .data/pglite.
# Production: the Neon pooled connection string (postgres://…).
DATABASE_URL=

# Image uploads (Cloudinary dashboard → API Keys). Uploads stay off until all three are set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Used by `npm run seed:admin` to create the first platform admin.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Without Cloudinary, uploads can go to a local folder (.data/uploads, or UPLOADS_DIR if set). That
# is on by default with `npm run dev`; set LOCAL_UPLOADS=1 to allow it under `npm start` on your own
# machine. Never rely on it on a hosting platform: the disk there doesn't survive a redeploy.
LOCAL_UPLOADS=
